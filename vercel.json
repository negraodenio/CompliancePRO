{
  "functions": {
    "api/server.ts": { "includeFiles": "dist-server/**" }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/server?route=/health" },
    { "source": "/ready", "destination": "/api/server?route=/ready" },
    { "source": "/api/v1/auth/:path*", "destination": "https://compliancepro-h6xb.onrender.com/api/v1/auth/:path*" },
    { "source": "/api/v1/:path*", "destination": "/api/server?route=/api/v1/:path*" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
